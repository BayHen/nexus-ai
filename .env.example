# Application
NEXUS_APP_NAME=NEXUS AI API
NEXUS_APP_VERSION=0.1.0
NEXUS_ENVIRONMENT=development
NEXUS_DEBUG=false
NEXUS_LOG_LEVEL=INFO
NEXUS_API_V1_PREFIX=/api/v1
APP_HOST=127.0.0.1
APP_PORT=8000
APP_SECRET_KEY=replace-with-a-long-random-value
FRONTEND_URL=http://localhost:3000
FRONTEND_PORT=3000
API_BASE_URL=http://127.0.0.1:8000

# PostgreSQL
POSTGRES_DB=nexus_ai
POSTGRES_USER=nexus_ai
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://nexus_ai:replace-with-a-local-password@127.0.0.1:5432/nexus_ai
NEXUS_DATABASE_CONNECT_TIMEOUT_SECONDS=3

# Redis
REDIS_URL=redis://localhost:6379/0

# RabbitMQ and Celery
RABBITMQ_DEFAULT_USER=nexus_ai
RABBITMQ_DEFAULT_PASS=replace-with-a-local-password
CELERY_BROKER_URL=amqp://nexus_ai:replace-with-a-local-password@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Authentication
JWT_SECRET_KEY=replace-with-a-long-random-value
JWT_ALGORITHM=HS256
NEXUS_JWT_ISSUER=nexus-ai
NEXUS_JWT_AUDIENCE=nexus-ai-api
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
NEXUS_PASSWORD_RESET_EXPIRE_MINUTES=30
NEXUS_AUTH_RATE_LIMIT_ATTEMPTS=5
NEXUS_AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Sandbox payments (use at least 32 random characters; never use this sandbox for real cards)
PAYMENT_WEBHOOK_SECRET=replace-with-a-separate-random-payment-webhook-secret

# OpenAI and AI integrations
OPENAI_API_KEY=
OPENAI_MODEL=
EMBEDDING_MODEL=

# AWS (leave empty for local development)
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Observability
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=
