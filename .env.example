# Application
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=replace-with-a-long-random-value
FRONTEND_URL=http://localhost:3000

# PostgreSQL
POSTGRES_DB=nexus_ai
POSTGRES_USER=nexus_ai
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql+psycopg://nexus_ai:replace-with-a-local-password@localhost:5432/nexus_ai

# Redis
REDIS_URL=redis://localhost:6379/0

# RabbitMQ and Celery
RABBITMQ_DEFAULT_USER=nexus_ai
RABBITMQ_DEFAULT_PASS=replace-with-a-local-password
CELERY_BROKER_URL=amqp://nexus_ai:replace-with-a-local-password@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Authentication
JWT_SECRET_KEY=replace-with-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# OpenAI and AI integrations
OPENAI_API_KEY=
OPENAI_MODEL=
EMBEDDING_MODEL=

# AWS (leave empty for local development)
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Observability
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=
