{
  "annotations": {"list": []},
  "editable": false,
  "panels": [
    {
      "type": "stat",
      "title": "API availability (5m)",
      "targets": [{"expr": "1 - (sum(rate(nexus_http_requests_total{route!=\"/health/live\",status_code=~\"5..\"}[5m])) / clamp_min(sum(rate(nexus_http_requests_total{route!=\"/health/live\"}[5m])), 0.001))"}],
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "API request rate",
      "targets": [{"expr": "sum by (route, status_code) (rate(nexus_http_requests_total[5m]))"}],
      "gridPos": {"h": 8, "w": 9, "x": 6, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "API p50 / p95 latency",
      "targets": [
        {"legendFormat": "p50", "expr": "histogram_quantile(0.50, sum by (le) (rate(nexus_http_request_duration_seconds_bucket[5m])))"},
        {"legendFormat": "p95", "expr": "histogram_quantile(0.95, sum by (le) (rate(nexus_http_request_duration_seconds_bucket[5m])))"}
      ],
      "gridPos": {"h": 8, "w": 9, "x": 15, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "Database p95 and errors",
      "targets": [
        {"legendFormat": "db p95", "expr": "histogram_quantile(0.95, sum by (le) (rate(nexus_db_operation_duration_seconds_bucket[5m])))"},
        {"legendFormat": "db errors", "expr": "sum(rate(nexus_db_operations_total{status=\"error\"}[5m]))"}
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
    },
    {
      "type": "timeseries",
      "title": "Worker outcomes",
      "targets": [{"expr": "sum by (status) (rate(nexus_worker_tasks_total[5m]))"}],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
    },
    {
      "type": "timeseries",
      "title": "PostgreSQL connections",
      "targets": [
        {"legendFormat": "application checked out", "expr": "nexus_db_connections_checked_out"},
        {"legendFormat": "postgres active", "expr": "pg_stat_activity_count{state=\"active\"}"}
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16}
    },
    {
      "type": "state-timeline",
      "title": "Dependency readiness",
      "targets": [{"expr": "nexus_dependency_ready"}],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16}
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["nexus-ai", "staging"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "NEXUS AI Overview",
  "uid": "nexus-overview",
  "version": 1
}
